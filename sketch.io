// ===============================================================
//  INCLUDE
// ===============================================================
// -------------------------- libraries --------------------------
#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ILI9341.h>
#include <RTClib.h>

// ------------------------- components --------------------------
#include "buzzer.h"
#include "tick.h"
#include "encoder.h"

// ===============================================================
//  CONFIG
// ===============================================================
// --------------------------- display ---------------------------
// #define TFT_DC 9
// #define TFT_CS 10
// #define TEXT_SIZE 10

// Adafruit_ILI9341 tft = Adafruit_ILI9341(TFT_CS, TFT_DC);

// ----------------------------- rtc -----------------------------
// RTC_DS1307 rtc;

// ===============================================================
//  BEEP & TICK FUNCTION
// ===============================================================
void beepAndTick() {
    buzzerUpdate();
    tickUpdate();
}

// ===============================================================
//  SETUP
// ===============================================================
void setup() {
    Serial.begin(115200);
    buzzerSetup();
    tickSetup();
    encoderSetup();
}

// ===============================================================
//  LOOP
// ===============================================================
void loop() {
    // ------------------------- encoder -------------------------
    encoderUpdate();
    int step = encoderConsumeSteps();

    if (encoderConsumeClick()) {
        Serial.println("CLICK");
    }

    if (step != 0) {
        Serial.println(step);
    }
}
